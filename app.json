{
  "expo": {
    "name": "appSales",
    "slug": "appSales",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/deal-icon.png",
    "scheme": "appsales",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C2747",
        "foregroundImage": "./assets/images/deal-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/deal-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C2747",
          "image": "./assets/images/deal-splash.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para adjuntar evidencia a las tareas de visita.",
          "cameraPermission": "La app usa la cámara para tomar fotos de evidencia en las tareas de visita."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
